{
  "name": "@lvce-editor/editor-commands-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "build:static": "node packages/build/src/build-static.js",
    "build:watch": "npm run build:watch --workspace build",
    "dev": "node packages/build/src/dev.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "measure": "cd packages/memory && npm run measure",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0"
  }
}
